Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Octomap1/Autocompute Value Bounds1
        - /Frames1
        - /Frames1/UAV1
      Splitter Ratio: 0.403694
    Tree Height: 775
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Octomap
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Cell Size: 1
      Class: rviz/Grid
      Color: 0; 85; 255
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2.22657
        Min Value: 0.273439
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: true
      Max Color: 220; 220; 220
      Max Intensity: 2.98438
      Min Color: 79; 79; 79
      Min Intensity: 0.015625
      Name: Octomap
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.06
      Style: Boxes
      Topic: /octomap_point_cloud_centers
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/Axes
          Enabled: true
          Length: 0.5
          Name: World
          Radius: 0.05
          Reference Frame: world
          Value: true
        - Class: rviz/Axes
          Enabled: true
          Length: 0.5
          Name: UAV
          Radius: 0.05
          Reference Frame: base_link
          Value: true
        - Class: rviz/Axes
          Enabled: true
          Length: 0.5
          Name: Map
          Radius: 0.05
          Reference Frame: map
          Value: true
      Enabled: true
      Name: Frames
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: false
          Marker Topic: /theta_star_example/vis_marker_ocuppancy
          Name: ThetaStar OccupancyMap
          Namespaces:
            {}
          Queue Size: 100
          Value: false
        - Class: rviz/Marker
          Enabled: false
          Marker Topic: /theta_star_example/vis_marker_explored
          Name: ThetaStar explored
          Namespaces:
            {}
          Queue Size: 100
          Value: false
        - Class: rviz/Marker
          Enabled: false
          Marker Topic: /theta_star_example/vis_marker_no_lineOfSight
          Name: ThetaStar NoLineOfSight
          Namespaces:
            {}
          Queue Size: 100
          Value: false
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: visualization_marker_path
          Name: ThetaStar Result Path
          Namespaces:
            theta_star: true
          Queue Size: 100
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: visualization_marker_trajectory
          Name: ThetaStar Result Trajectory
          Namespaces:
            theta_star: true
          Queue Size: 100
          Value: true
      Enabled: true
      Name: ThetaStar Debug
    - Angle Tolerance: 0.05
      Class: rviz/Odometry
      Color: 255; 170; 0
      Enabled: true
      Keep: 100
      Length: 0.25
      Name: Odometry
      Position Tolerance: 0.1
      Topic: /odometry
      Value: true
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 1000
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 11.7175
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.929581
        Y: 0.128984
        Z: 1.4789
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.659797
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.61011
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1056
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Views:
    collapsed: true
  Width: 1855
  X: 65
  Y: 24
