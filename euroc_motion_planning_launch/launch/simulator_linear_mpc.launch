<!-- 
	Neo Simulator and Position Controller launcher
-->

<launch>
  <arg name="mav_name" default="euroc5"/>
  <arg name="enable_logging" default="false" />
  <arg name="enable_ground_truth" default="true" />
  <arg name="log_file" default="$(arg mav_name)" />
  <arg name="gazebo_paused" default="true" />
  <arg name="gazebo_world" default="$(find rotors_gazebo)/worlds/basic.world" />

  <!-- Simulator -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg gazebo_world)"/>
    <arg name="paused" value="$(arg gazebo_paused)"/>
  </include>

  <group ns="$(arg mav_name)">
	<!-- Spawn Neo -->
    <include file="$(find rotors_gazebo)/launch/spawn_mav.launch">
      <arg name="mav_name" value="$(arg mav_name)" />
	  <arg name="model" value="$(find euroc_hex_description)/urdf/euroc_hex_vi_sensor.gazebo" />
      <arg name="enable_logging" value="$(arg enable_logging)" />
      <arg name="enable_ground_truth" value="$(arg enable_ground_truth)" />
      <arg name="log_file" value="$(arg log_file)"/>
    </include>
	
	<!-- Publish TF ground (/world) to UAV (/base_link) from odometry messages-->
	<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
	<node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" /> 
	<node name="ground_truth_to_tf" pkg="message_to_tf" type="message_to_tf" output="screen">
		<param name="odometry_topic" value="ground_truth/odometry" />
		<param name="frame_id" value="world" />
		<param name="child_frame_id" value="$(arg mav_name)/base_link" />
	</node>
	<!-- AsTec Neo Position Controller for simulations -->
    <node name="mav_linear_mpc" pkg="mav_linear_mpc" type="mav_linear_mpc_node_controller_only" respawn="true" clear_params="true" output="log">
      <remap from="odometry" to="ground_truth/odometry" />
      <rosparam file="$(find euroc_motion_planning_launch)/parameters/neo/linear_mpc.yaml" />
      <param name="verbose" value="true" />
      <param name="controller/mass" value="2.707" />
    </node>
    <node name="PD_attitude_controller" pkg="mav_linear_mpc" type="PD_attitude_controller_node" respawn="true" clear_params="true" output="screen">
      <remap from="odometry" to="ground_truth/odometry" />
      <rosparam file="$(find euroc_motion_planning_launch)/parameters/neo/PD_attitude.yaml" />
    </node>
  </group>
 
</launch>
