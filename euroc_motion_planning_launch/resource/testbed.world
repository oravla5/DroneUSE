				</geometry>
			</visual>
		</link>
	</model>
-->
	
	<model name="room">
		<pose>0 0 0.0 0 0 0</pose>
		<static>true</static>
		<link name="room_link">
		  
			<collision name="room_collision">
				<pose>0 0 0.0 0 0 0</pose>
				<geometry>
				  <mesh>
					<scale>1 1 1</scale>
					<uri>model://collada/only_room.dae</uri>
				  </mesh>
				</geometry>
			</collision>

			<visual name="room_visual">
				<pose>0 0 0.0 0 0 0</pose>
				<geometry>
				  <mesh>
					<scale>1 1 1</scale>
					<uri>model://collada/only_room.dae</uri>
				  </mesh>
				</geometry>
			</visual>
		</link>
	</model>

	<model name="box_1">
		<pose>2.5 0 0.0 0 0 0</pose>
		<static>true</static>
		<link name="box_1_link">
		  
			<collision name="box_collision">
				<pose>0.0 0 0.0 0 0 0</pose>
				<geometry>
				  <mesh>
					<scale>1 1 1</scale>
					<uri>model://collada/only_box.dae</uri>
				  </mesh>
				</geometry>
			</collision>

			<visual name="box_visual">
				<pose>0.0 0 0.0 0 0 0</pose>
				<geometry>
				  <mesh>
					<scale>1 1 1</scale>
					<uri>model://collada/only_box.dae</uri>
				  </mesh>
				</geometry>
			</visual>
		</link>
	</model>

	<model name="box_2">
		<pose>-1.5 0 0.0 0 0 0</pose>
		<static>true</static>
		<link name="box_2_link">
			<collision name="box_collision">
				<pose>0.0 0 0.0 0 0 0</pose>
				<geometry>
				  <mesh>
					<scale>1 1 1</scale>
					<uri>model://collada/only_box.dae</uri>
				  </mesh>
				</geometry>
			</collision>

			<visual name="box_visual">
				<pose>0.0 0 0.0 0 0 0</pose>
				<geometry>
				  <mesh>
					<scale>1 1 1</scale>
					<uri>model://collada/only_box.dae</uri>
				  </mesh>
				</geometry>
			</visual>
		</link>
	</model>
    
  </world>
</sdf>
