<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
	<gui>
		<camera name="global_camera">
			<pose>-3.5 -5.0 5.5 0.0 0.55 0.7</pose>
		</camera>
	</gui>  
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <physics type='ode'>
      <ode>
        <solver>
          <type>quick</type>
          <iters>1000</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>
    
    
<!--
	<model name="a380">
		<pose>0 0 0.0 0 0 0</pose>
		<static>true</static>
		<link name="a380_link">
		  
			<collision name="a380_collision">
				<pose>0 0 0.0 0 0 0</pose>
				<geometry>
				  <mesh>
					<scale>0.1 0.1 0.1</scale>
					<uri>model://collada/a380.dae</uri>
				  </mesh>
				</geometry>
			</collision>

			<visual name="room_visual">
				<pose>0 0 0.0 0 0 0</pose>
				<geometry>
				  <mesh>
					<scale>0.1 0.1 0.1</scale>
